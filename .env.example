# ---------------------------------------------------------------------------
# El Impostor API — environment variables
#
# The game runs with ZERO keys: the word pools and the curated hints ship in
# app/config.py. Everything below is optional and only unlocks an extra.
# Copy this file to .env and fill in what you need.
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------
# Default is a local SQLite file, created automatically on first run.
DATABASE_URL=sqlite+aiosqlite:///./impostor.db
# Production example (Postgres):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/impostor

# --- Sessions -------------------------------------------------------------
# Required in production. Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-change-in-prod

# --- Optional: LLM --------------------------------------------------------
# Used only for custom categories (picking a word, generating a hint).
# Set ONE of the two: OPENAI_API_KEY takes priority on provider "auto".
# With neither, the game uses the static pools and the curated hints.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Optional: Google login -----------------------------------------------
# Enables saved history and named players. Leave empty to play anonymously.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: legacy Telegram delivery -----------------------------------
# Older flow that DMs each player their word. Not needed to play: the
# single-device mode shows each card on one phone.
TELEGRAM_TOKEN=
